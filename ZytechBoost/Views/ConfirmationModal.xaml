<Window x:Class="ZytechBoost.Views.ConfirmationModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ZytechBoost.Models"
        Title="Confirmación Requerida"
        Width="580" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBgBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Background="{StaticResource PrimaryBgBrush}" CornerRadius="14"
            BorderThickness="1" BorderBrush="{StaticResource DangerBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ HEADER ═══════════ -->
            <Border Grid.Row="0" Background="#33EF4444" CornerRadius="14,14,0,0"
                    Padding="24,16">
                <StackPanel>
                    <TextBlock Text="⚠  ZONA EXTREMA" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Se requiere confirmación explícita" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══════════ CONTENT ═══════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <!-- Warning text -->
                    <Border Background="#22EF4444" CornerRadius="8" Padding="16" 
                            Margin="0,0,0,16" BorderThickness="1" BorderBrush="#44EF4444">
                        <TextBlock x:Name="WarningContent" 
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                    </Border>

                    <!-- Categories being applied -->
                    <TextBlock Text="Categorías que se aplicarán:" 
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ItemsControl x:Name="CategoryList" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OptiCategory}">
                                <Border Background="{StaticResource CardBgBrush}" 
                                        CornerRadius="8" Padding="12,8" Margin="0,0,0,6"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Confirmation input -->
                    <TextBlock Text="Escribe CONFIRMAR para continuar:" 
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    
                    <TextBox x:Name="ConfirmInput" 
                             Style="{StaticResource DarkTextBox}"
                             FontSize="18" FontWeight="Bold"
                             CharacterCasing="Upper"
                             MaxLength="20"
                             MinHeight="48"
                             TextChanged="ConfirmInput_TextChanged"/>

                    <TextBlock x:Name="InputHint" 
                               Text="Debe escribir exactamente: CONFIRMAR"
                               Style="{StaticResource SmallText}" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════ BUTTONS ═══════════ -->
            <Border Grid.Row="2" Padding="24,12" Background="{StaticResource HeaderBgBrush}"
                    CornerRadius="0,0,14,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0" Click="BtnCancel_Click" MinWidth="120"/>
                    <Button x:Name="BtnConfirm" Content="☠  APLICAR ZONA EXTREMA"
                            Style="{StaticResource DangerButton}" IsEnabled="False"
                            Click="BtnConfirm_Click" MinWidth="200"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

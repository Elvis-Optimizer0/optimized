<UserControl x:Class="ZytechBoost.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ZytechBoost.Models"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="← Volver" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="BtnBack_Click" Margin="0,0,0,12"
                    Padding="12,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CategoryIcon" FontSize="36" Margin="0,0,12,0"
                           VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CategoryTitle" Style="{StaticResource TitleText}" FontSize="28"/>
                    <TextBlock x:Name="CategoryDesc" Style="{StaticResource SubtitleText}" 
                               FontSize="14" Margin="0,2,0,0" MaxWidth="600"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ═══════════ WARNING BANNER (for Extreme) ═══════════ -->
        <Border x:Name="WarningBanner" Grid.Row="1" 
                Background="#33EF4444" CornerRadius="10"
                Padding="16,12" Margin="0,0,0,16"
                BorderThickness="1" BorderBrush="{StaticResource DangerBrush}"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="WarningText" Style="{StaticResource DangerText}"
                           TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ PROGRESS BAR ═══════════ -->
        <ProgressBar x:Name="ProgressBar" Grid.Row="2" 
                     Style="{StaticResource DarkProgressBar}"
                     Margin="0,0,0,16" Visibility="Collapsed"/>

        <!-- ═══════════ TOGGLE LIST ═══════════ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TweakList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Tweak}">
                        <Border Style="{StaticResource ToggleRowBorder}"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0" Width="44" Height="44"
                                        Background="{StaticResource SecondaryBgBrush}"
                                        CornerRadius="10" Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name + Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" MaxWidth="500"/>
                                </StackPanel>

                                <!-- Toggle + Status -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                    <!-- Applied checkmark -->
                                    <TextBlock x:Name="CheckMark" Text="✓" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Visibility="Collapsed">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="0" ScaleY="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>

                                    <!-- Toggle Switch -->
                                    <ToggleButton IsChecked="{Binding IsEnabled}"
                                                  Style="{StaticResource ToggleSwitch}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══════════ APPLY BUTTON ═══════════ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" 
                    Margin="0,20,0,0">
            <Button x:Name="BtnApplyCategory" 
                    Style="{StaticResource AccentButton}"
                    FontSize="16" MinWidth="260" MinHeight="52"
                    Click="BtnApplyCategory_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡  Aplicar categoría" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

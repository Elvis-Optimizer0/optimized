<UserControl x:Class="ZytechBoost.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ZytechBoost.Models"
             xmlns:views="clr-namespace:ZytechBoost.Views"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: MAIN CONTENT ═══════════ -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Button Content="← Volver" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Click="BtnBack_Click" Margin="0,0,0,12"
                        Padding="12,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CategoryIcon" FontSize="36" Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CategoryTitle" Style="{StaticResource TitleText}" FontSize="28"/>
                        <TextBlock x:Name="CategoryDesc" Style="{StaticResource SubtitleText}" 
                                   FontSize="14" Margin="0,2,0,0" MaxWidth="600"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- WARNING BANNER -->
            <Border x:Name="WarningBanner" Grid.Row="1" 
                    Background="#33EF4444" CornerRadius="10"
                    Padding="16,12" Margin="0,0,0,16"
                    BorderThickness="1" BorderBrush="{StaticResource DangerBrush}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="WarningText" Style="{StaticResource DangerText}"
                               TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- SELECTED COUNT -->
            <Border x:Name="SelectedCountBorder" Grid.Row="2"
                    Background="{StaticResource SecondaryBgBrush}" CornerRadius="8"
                    Padding="14,8" Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✅" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SelectedCountText" Text="0 seleccionados"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" de " FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="4,0"/>
                    <TextBlock x:Name="TotalCountText" Text="0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- TOGGLE LIST -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TweakList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Tweak}">
                            <Border Style="{StaticResource ToggleRowBorder}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44"
                                            Background="{StaticResource SecondaryBgBrush}"
                                            CornerRadius="10" Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" MaxWidth="500"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="CheckMark" Text="✓" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Visibility="Collapsed">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform ScaleX="0" ScaleY="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <ToggleButton IsChecked="{Binding IsEnabled}"
                                                      Style="{StaticResource ToggleSwitch}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- BUTTONS: Execute All + Execute Selected -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" 
                        Margin="0,20,0,0">
                <Button x:Name="BtnApplyAll" 
                        Style="{StaticResource AccentButton}"
                        FontSize="14" MinWidth="220" MinHeight="48"
                        Click="BtnApplyAll_Click" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡  Ejecutar todos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnApplySelected" 
                        Style="{StaticResource SecondaryButton}"
                        FontSize="14" MinWidth="240" MinHeight="48"
                        Click="BtnApplySelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅  Ejecutar seleccionados" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════ RIGHT: EXECUTION PANEL ═══════════ -->
        <views:ExecutionPanel x:Name="ExecPanel" Grid.Column="1"
                              Width="380" Margin="0"
                              Visibility="Collapsed"/>
    </Grid>
</UserControl>

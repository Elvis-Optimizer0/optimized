<UserControl x:Class="ZytechBoost.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ZytechBoost.Models"
             xmlns:views="clr-namespace:ZytechBoost.Views"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: MAIN CONTENT ═══════════ -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Panel de Control" Style="{StaticResource TitleText}" FontSize="32"/>
                <TextBlock Text="Selecciona una categoría o ejecuta la optimización completa" 
                           Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- STATUS PANEL -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,20"
                    Background="{StaticResource SecondaryBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="80" Height="80" Margin="0,0,20,0">
                        <Ellipse Stroke="{StaticResource BorderSubtleBrush}" StrokeThickness="6" Fill="Transparent"/>
                        <Ellipse x:Name="ProgressRing" Stroke="{StaticResource AccentBrush}" 
                                 StrokeThickness="6" Fill="Transparent"
                                 StrokeDashArray="3.14 3.14" StrokeDashCap="Round">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90" CenterX="40" CenterY="40"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="GaugeText" Text="0" 
                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="activos" FontSize="9" 
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="RamInfoText" Text="Cargando..." 
                                   Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeviceTypeText" Text="Detectando..."
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock x:Name="BatteryWarning" Text="⚠ Batería detectada — algunos tweaks de energía podrían afectar autonomía" 
                                   Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="12,8"
                                BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <StackPanel>
                                <TextBlock Text="Restore Point" FontSize="11" 
                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="RestoreStatusText" Text="Pendiente" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HERO BUTTONS -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Button x:Name="BtnOptimizeAll" Content="⚡  OPTIMIZAR TODO (SEGURO)" 
                        Style="{StaticResource HeroButton}" Click="BtnOptimizeAll_Click" Margin="0,0,16,0"/>
                <Button x:Name="BtnExtremeMode" Content="☠  MODO EXTREMO" 
                        Style="{StaticResource DangerButton}" Click="BtnExtremeMode_Click"/>
            </StackPanel>

            <!-- CATEGORY GRID -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TileContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:OptiCategory}">
                            <Button Style="{StaticResource CategoryTile}" 
                                    Width="240" Height="150" Margin="0,0,16,16"
                                    Click="Tile_Click" Tag="{Binding}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="36" 
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,4,0,0" TextAlignment="Center"
                                               HorizontalAlignment="Center" MaxWidth="200"
                                               Text="{Binding Description}" TextTrimming="CharacterEllipsis"/>
                                    <Border Background="{StaticResource DangerBrush}" CornerRadius="4" 
                                            Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Center"
                                            Visibility="{Binding IsExtreme, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="EXTREMO" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- FOOTER -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="📋 Ver Log de Sesión" Style="{StaticResource SecondaryButton}" 
                        Click="BtnViewLog_Click" Margin="0,0,8,0"/>
                <Button Content="📜 Historial" Style="{StaticResource SecondaryButton}" 
                        Click="BtnViewHistory_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ RIGHT: EXECUTION PANEL ═══════════ -->
        <views:ExecutionPanel x:Name="ExecPanel" Grid.Column="1" 
                              Width="380" Margin="0"
                              Visibility="Collapsed"/>
    </Grid>
</UserControl>

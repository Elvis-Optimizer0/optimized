<UserControl x:Class="ZytechBoost.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="← Volver" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="BtnBack_Click" Margin="0,0,0,12"
                    Padding="12,8"/>
            <TextBlock Text="📋 Registro de Sesión" Style="{StaticResource TitleText}" FontSize="28"/>
            <TextBlock x:Name="LogFilePath" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ═══════════ LOG CONTENT ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SecondaryBgBrush}" 
                        CornerRadius="10,10,0,0" Padding="14,8">
                    <TextBlock Text="Salida del script en tiempo real:" 
                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                </Border>

                <ScrollViewer x:Name="LogScroller" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <RichTextBox x:Name="LogContent"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Padding="14,10"
                                 IsDocumentEnabled="False"
                                 AcceptsReturn="True">
                        <RichTextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════ BUTTONS ═══════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <Button Content="🔄 Actualizar" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0" Click="BtnRefresh_Click"/>
            <Button Content="📁 Abrir carpeta del log" Style="{StaticResource SecondaryButton}"
                    Click="BtnOpenFolder_Click"/>
        </StackPanel>
    </Grid>
</UserControl>

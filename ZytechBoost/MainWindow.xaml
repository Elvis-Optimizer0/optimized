<Window x:Class="ZytechBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zytech Boost"
        Width="1100" Height="750"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBgBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource PrimaryBgBrush}" 
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{StaticResource BorderSubtleBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════ HEADER BAR ═══════════════ -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderBgBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Title -->
                    <StackPanel Orientation="Horizontal" Margin="16,0" 
                                VerticalAlignment="Center">
                        <!-- Logo icon (wine/gaming aesthetic) -->
                        <Border Width="32" Height="32" 
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="8"
                                Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="18" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="White"/>
                        </Border>
                        <TextBlock Text="ZYTECH BOOST" 
                                   FontFamily="Segoe UI" FontWeight="Bold" 
                                   FontSize="16"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  v1.0" 
                                   FontFamily="Segoe UI" FontWeight="Normal"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Content="─"
                                Width="46" Height="32"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnMinimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnMaximize" Content="☐"
                                Width="46" Height="32"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnMaximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnClose" Content="✕"
                                Width="46" Height="32"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnClose_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
            <Frame x:Name="MainFrame" Grid.Row="1" 
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource PrimaryBgBrush}"/>

            <!-- ═══════════════ STATUS BAR ═══════════════ -->
            <Border Grid.Row="2" 
                    Background="{StaticResource HeaderBgBrush}"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusBarText" 
                               Text="Listo"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" 
                                 Fill="{StaticResource SuccessBrush}" 
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Admin ✓" 
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

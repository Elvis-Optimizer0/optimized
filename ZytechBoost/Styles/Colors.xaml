<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  PALETA ZYTECH BOOST — Negro / Gris / Vino Tinto      -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- FONDOS -->
    <Color x:Key="PrimaryBg">#FF0A0A0F</Color>
    <Color x:Key="SecondaryBg">#FF121218</Color>
    <Color x:Key="CardBg">#FF1A1A24</Color>
    <Color x:Key="CardHoverBg">#FF222230</Color>
    <Color x:Key="ModalBg">#FF16161F</Color>
    <Color x:Key="HeaderBg">#FF0E0E14</Color>

    <!-- ACENTO / VINO TINTO -->
    <Color x:Key="Accent">#FF8B1A2B</Color>
    <Color x:Key="AccentLight">#FFB22A3E</Color>
    <Color x:Key="AccentDark">#FF6A1020</Color>
    <Color x:Key="AccentGlow">#998B1A2B</Color>

    <!-- TEXTO -->
    <Color x:Key="PrimaryText">#FFE8E8EC</Color>
    <Color x:Key="SecondaryText">#FF9999AA</Color>
    <Color x:Key="MutedText">#FF666677</Color>
    <Color x:Key="DisabledText">#FF444455</Color>

    <!-- ESTADOS -->
    <Color x:Key="Success">#FF22C55E</Color>
    <Color x:Key="SuccessGlow">#4422C55E</Color>
    <Color x:Key="Warning">#FFF59E0B</Color>
    <Color x:Key="WarningGlow">#44F59E0B</Color>
    <Color x:Key="Danger">#FFEF4444</Color>
    <Color x:Key="DangerGlow">#44EF4444</Color>

    <!-- BORDES -->
    <Color x:Key="BorderSubtle">#FF2A2A38</Color>
    <Color x:Key="BorderActive">#FF8B1A2B</Color>

    <!-- SWITCH -->
    <Color x:Key="SwitchOff">#FF3A3A4A</Color>
    <Color x:Key="SwitchOn">#FF8B1A2B</Color>
    <Color x:Key="SwitchThumb">#FFE8E8EC</Color>

    <!-- SCROLLBAR -->
    <Color x:Key="ScrollbarThumb">#FF3A3A4A</Color>
    <Color x:Key="ScrollbarTrack">#FF0A0A0F</Color>

    <!-- SOLID BRUSHES -->
    <SolidColorBrush x:Key="PrimaryBgBrush" Color="{StaticResource PrimaryBg}"/>
    <SolidColorBrush x:Key="SecondaryBgBrush" Color="{StaticResource SecondaryBg}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}"/>
    <SolidColorBrush x:Key="CardHoverBgBrush" Color="{StaticResource CardHoverBg}"/>
    <SolidColorBrush x:Key="ModalBgBrush" Color="{StaticResource ModalBg}"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBg}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDark}"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlow}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledText}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="SuccessGlowBrush" Color="{StaticResource SuccessGlow}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningGlowBrush" Color="{StaticResource WarningGlow}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerGlowBrush" Color="{StaticResource DangerGlow}"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="BorderActiveBrush" Color="{StaticResource BorderActive}"/>

    <SolidColorBrush x:Key="SwitchOffBrush" Color="{StaticResource SwitchOff}"/>
    <SolidColorBrush x:Key="SwitchOnBrush" Color="{StaticResource SwitchOn}"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="{StaticResource SwitchThumb}"/>

    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumb}"/>
    <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="{StaticResource ScrollbarTrack}"/>

</ResourceDictionary>
